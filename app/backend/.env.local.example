APP_NAME=SnapTrip API
APP_ENV=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=local-dev-session-secret-not-for-production
COOKIE_SECURE=false
COOKIE_DOMAIN=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=snaptrip
GRIDFS_BUCKET=snaptrip_images
CLASSIFIER_MODEL_PATH=../../training/output/model/snaptrip_mobilenetv4_medium_v2_best.pth
CLASSIFIER_MODEL_VERSION=2026-05-mvp-mobilenetv4-medium-v2
CLASSIFIER_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_PLACES_API_KEY=
USE_GOOGLE_PLACES=false
USE_GEMINI=false
AI_OBSERVABILITY_ENABLED=true
AI_RAW_LLM_OBSERVABILITY=true
AI_RAW_LLM_LOGS=false
AI_OBSERVABILITY_TTL_SECONDS=604800
AI_OBSERVABILITY_MAX_FIELD_BYTES=262144
