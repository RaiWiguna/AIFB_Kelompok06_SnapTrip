APP_ENV=production
RELEASE_SHA=replace-me
COMPOSE_PROJECT_NAME=snaptrip-production
SHARED_DIR=/opt/snaptrip/hosted/shared
WEB_DOMAIN=snaptrip.site
API_DOMAIN=api.snaptrip.site
CADDY_EMAIL=replace-me@example.com
MONGO_ROOT_USERNAME=replace-me
MONGO_ROOT_PASSWORD=replace-me
MONGO_DATABASE=snaptrip
SESSION_SECRET=replace-me
COOKIE_DOMAIN=snaptrip.site
GRIDFS_BUCKET=snaptrip_images
CLASSIFIER_MODEL_PATH=/app/models/snaptrip_mobilenetv4_medium_v2_best.pth
CLASSIFIER_MODE=real
CLASSIFIER_MODEL_VERSION=2026-05-mvp-mobilenetv4-medium-v2
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_PLACES_API_KEY=replace-me
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=replace-me
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_OBSERVABILITY_ENABLED=true
AI_RAW_LLM_OBSERVABILITY=true
AI_RAW_LLM_LOGS=false
AI_OBSERVABILITY_TTL_SECONDS=604800
AI_OBSERVABILITY_MAX_FIELD_BYTES=262144
PLACES_CACHE_TTL_SECONDS=604800
MAX_UPLOAD_IMAGE_BYTES=8388608
MAX_UPLOAD_IMAGES=8
